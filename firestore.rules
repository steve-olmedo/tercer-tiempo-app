rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidConfig(data) {
      return data.pitchCost is number && data.pitchCost >= 0
        && (!('depositPaid' in data) || data.depositPaid is number)
        && (!('fondoRecaudador' in data) || data.fondoRecaudador is number)
        && (!('pendingFondoRecaudador' in data) || data.pendingFondoRecaudador is number)
        && (!('fondoEmi' in data) || data.fondoEmi is number)
        && (!('recaudadorName' in data) || data.recaudadorName is string)
        && (!('matchTitle' in data) || (data.matchTitle is string && data.matchTitle.size() <= 100));
    }

    function isValidPlayer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && (!('initialBalance' in data) || data.initialBalance is number)
        && data.playedToday is bool
        && data.paidToday is number && data.paidToday >= 0
        && data.paymentMethod in ['efectivo', 'mercadopago']
        && data.playsNextWeek is bool
        && (!('vuelto' in data) || data.vuelto is number)
        && (!('mpAlias' in data) || data.mpAlias is string)
        && (!('receiptCount' in data) || data.receiptCount is number)
        && (!('orderIndex' in data) || data.orderIndex is number);
    }

    function isValidHistory(data) {
      return data.date is string && data.date.size() <= 30
        && data.timestamp is number
        && data.pitchCost is number
        && data.costPerPerson is number
        && data.playedCount is number
        && data.cashTotal is number
        && data.mpTotal is number
        && data.totalCollected is number;
    }

    // Public test connection doc
    match /test/connection {
      allow read, write: if true;
    }

    // Match Configuration
    match /config/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create, update: if isValidId(configId) && isValidConfig(request.resource.data);
      allow delete: if false;
    }

    // Players Collection
    match /players/{playerId} {
      allow get: if isValidId(playerId);
      allow list: if true;
      allow create, update: if isValidId(playerId) && isValidPlayer(request.resource.data);
      allow delete: if isValidId(playerId);
    }

    // History Collection
    match /history/{historyId} {
      allow get: if isValidId(historyId);
      allow list: if true;
      allow create: if isValidId(historyId) && isValidHistory(request.resource.data);
      allow update, delete: if isValidId(historyId);
    }

    // Teams Formation Collection (Real-time collaborative drafting)
    match /teams/{teamId} {
      allow get: if isValidId(teamId);
      allow list: if true;
      allow create, update, delete: if isValidId(teamId);
    }

    // Mercado Pago Receipts Collection
    match /receipts/{receiptId} {
      allow get: if isValidId(receiptId);
      allow list: if true;
      allow create, update, delete: if isValidId(receiptId);
    }

    // Player Aliases & Titular mapping
    match /aliases/{aliasId} {
      allow get: if isValidId(aliasId);
      allow list: if true;
      allow create, update, delete: if isValidId(aliasId);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
